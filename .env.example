# ── LLM ──
RECIPE_LLM_API_KEY=your_api_key_here
RECIPE_LLM_BASE_URL=https://api.minimax.chat/v1
RECIPE_LLM_MODEL=MiniMax-M1
RECIPE_LLM_TEMPERATURE=0.3
RECIPE_LLM_MAX_TOKENS=2048

# ── 检索 ──
RECIPE_RETRIEVER_TOP_K=10
RECIPE_RERANK_TOP_K=5

# ── 向量存储 ──
RECIPE_VECTOR_STORE_PATH=src/data/vector_store
RECIPE_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RECIPE_CLIP_MODEL=openai/clip-vit-base-patch32

# ── SQL ──
RECIPE_SQL_DATABASE_URL=sqlite:///./recipe.db
RECIPE_SQL_MAX_ROWS=100
RECIPE_SQL_QUERY_TIMEOUT_MS=3000

# ── 调试 ──
RECIPE_DEBUG=true

# ── Redis ──
RECIPE_REDIS_HOST=localhost
RECIPE_REDIS_PORT=6379
RECIPE_REDIS_DB=0
RECIPE_REDIS_PASSWORD=
RECIPE_REDIS_SESSION_TTL=86400
